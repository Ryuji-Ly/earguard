# Copy this file to .env and fill in your Supabase project's values
# (Supabase dashboard → Connect, or Project Settings → API Keys).
# Both are public by design: data is protected by Row Level Security, not by hiding these.
# Never put the secret / service_role key or the database password here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_your-key
